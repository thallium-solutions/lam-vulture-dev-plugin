# Test: live reload registration, gating and script injection, through
# the installed-package boundary and in-process dispatch.
#
# expect: outside lamc dev: enabled=false events=404 untouched=true
# expect: under lamc dev: enabled=true events-js=200
# expect: forced routes: js=200 type=application/javascript; charset=utf-8 cache=no-store
# expect: script reloads on boot change: true
# expect: script shares one stream: lock=true channel=true relay=true fallback=true
# expect: script leaves on pagehide: true before navigating: true rejoins from bfcache: true
# expect: script keeps events and reconnect: true
# expect: document: injected=true before-body=true once=true
# expect: content-length follows: true
# expect: non-ASCII document: injected=true text=true content-length=bytes
# expect: fragment untouched: true
# expect: json untouched: true
# expect: custom path: /dev/reload.js tag=true
# expect: changes: [a.css b.js c.css]
# expect: snapshot reads every file once: reads=2
# expect: unchanged files are not read again: reads=2 same=true
# expect: a rewrite of the same size is read: reads=3 changed=[a.css]
# expect: a rewrite with the same content changes nothing: reads=4 changed=[]
# expect: a file modified in the last 2 s is read every time: reads=6
# expect: a removed file leaves the snapshot: changed=[b.js] files=2
# expect: ok

from @lam/vulture import Server, Request, Response, InjectResponse
from @lam/vulture/dev-plugin import LiveReload, LiveReloadPath, liveReload, liveReloadPlugin
from lamenv import Env
from lamos import Os
from lampath import Path
from lamtime import Time

go! {
    import (
        "os"
        "time"
    )
}

func age(path: str, seconds: int) {
    #- Sets the modification time of ``path`` to ``seconds`` ago. -#
    go! {
        at := time.Now().Add(-time.Duration(seconds) * time.Second)
        os.Chtimes(path, at, at)
    }
}

func checkSnapshots() {
    root: str = Os.tempDir() + "/lam-live-snapshot-" + str(Time.nowUnixNano())
    _ = Os.mkdir(root)
    _ = Os.writeFile(root + "/a.css", "body{1}")
    _ = Os.writeFile(root + "/b.js", "1")
    age(root + "/a.css", 3600)
    age(root + "/b.js", 3600)
    live: LiveReload = LiveReload([root], "/__lam/live-reload", 50)

    first: dict[str, str] = live.snapshot()
    print(f"snapshot reads every file once: reads={live.reads}")
    second: dict[str, str] = live.snapshot()
    print(f"unchanged files are not read again: reads={live.reads} same={first == second}")

    _ = Os.writeFile(root + "/a.css", "body{2}")
    age(root + "/a.css", 1800)
    third: dict[str, str] = live.snapshot()
    print(f"a rewrite of the same size is read: reads={live.reads} changed=[{' '.join([Path.base(f) for f in LiveReload.changes(second, third)])}]")

    _ = Os.writeFile(root + "/a.css", "body{2}")
    age(root + "/a.css", 900)
    fourth: dict[str, str] = live.snapshot()
    print(f"a rewrite with the same content changes nothing: reads={live.reads} changed=[{' '.join(LiveReload.changes(third, fourth))}]")

    _ = Os.writeFile(root + "/c.js", "fresh")
    _ = live.snapshot()
    fifth: dict[str, str] = live.snapshot()
    print(f"a file modified in the last 2 s is read every time: reads={live.reads}")

    _ = Os.remove(root + "/b.js")
    sixth: dict[str, str] = live.snapshot()
    print(f"a removed file leaves the snapshot: changed=[{' '.join([Path.base(f) for f in LiveReload.changes(fifth, sixth)])}] files={len(sixth)}")
    _ = Os.removeAll(root)
}

const Document: str = "<!doctype html><html><head><title>t</title></head><body><main>hi</main></body></html>"
# Multi-byte characters: Content-Length counts bytes, not characters.
const UnicodeDocument: str = "<!doctype html><html><head><meta charset=\"utf-8\"><title>Città</title></head><body><main>caffè ☕ 日本語 — ünïcödé</main></body></html>"

class Pages {
    static func document(_req: Request, res: Response) {
        res.html(Document)
    }

    static func sized(_req: Request, res: Response) {
        res.headers["Content-Length"] = str(len(bytes(Document)))
        res.html(Document)
    }

    static func unicode(_req: Request, res: Response) {
        res.headers["Content-Length"] = str(len(bytes(UnicodeDocument)))
        res.html(UnicodeDocument)
    }

    static func fragment(_req: Request, res: Response) {
        res.html("<li>partial</li>")
    }

    static func data(_req: Request, res: Response) {
        res.json({"body": "</body>"})
    }
}

func server(plugin: func(Server)) -> Server {
    srv: Server = Server()
    srv.get("/", Pages.document)
    srv.get("/sized", Pages.sized)
    srv.get("/unicode", Pages.unicode)
    srv.get("/fragment", Pages.fragment)
    srv.get("/data", Pages.data)
    srv.register(plugin)
    return srv
}

func main() {
    _ = Env.unset("LAMC_DEV")
    plain: Server = server(liveReloadPlugin())
    events: InjectResponse = plain.inject("GET", LiveReloadPath)
    page: InjectResponse = plain.inject("GET", "/")
    print(f"outside lamc dev: enabled={LiveReload.enabled()} events={events.status} untouched={page.body == Document}")

    _ = Os.setenv("LAMC_DEV", "1")
    dev: Server = Server()
    liveReload(dev)
    print(f"under lamc dev: enabled={LiveReload.enabled()} events-js={dev.inject('GET', LiveReloadPath + '.js').status}")
    _ = Env.unset("LAMC_DEV")

    srv: Server = server(liveReloadPlugin(force=true))
    js: InjectResponse = srv.inject("GET", LiveReloadPath + ".js")
    print(f"forced routes: js={js.status} type={js.header('Content-Type')} cache={js.header('Cache-Control')}")
    print(f"script reloads on boot change: {'data !== boot' in js.body and 'location.reload()' in js.body}")
    # One stream per browser and origin (the 6-connection HTTP/1.1 limit):
    # a Web Locks leader reads it and relays over a BroadcastChannel; without
    # either API every tab keeps its own EventSource.
    lock: bool = "navigator.locks.request(name" in js.body
    channel: bool = "new BroadcastChannel(name)" in js.body
    relay: bool = "postMessage(" in js.body and "\"hello\"" in js.body
    fallback: bool = "navigator.locks && window.BroadcastChannel" in js.body
    print(f"script shares one stream: lock={lock} channel={channel} relay={relay} fallback={fallback}")
    leaves: bool = "addEventListener(\"pagehide\"" in js.body and "source.close()" in js.body
    early: bool = "addEventListener(\"beforeunload\"" in js.body
    rejoins: bool = "addEventListener(\"pageshow\"" in js.body and "event.persisted" in js.body
    print(f"script leaves on pagehide: {leaves} before navigating: {early} rejoins from bfcache: {rejoins}")
    kept: list[str] = ["\"lam:live-reload\"", "cancelable: true", "\"lam:live-styles\"", "lam-live-reload", "window.scrollTo", "setTimeout(open, 300)"]
    print(f"script keeps events and reconnect: {kept.all(lambda text: text in js.body)}")

    doc: str = srv.inject("GET", "/").body
    tag: str = f"<script src=\"{LiveReloadPath}.js\""
    print(f"document: injected={tag in doc} before-body={doc.index(tag) < doc.index('</body>')} once={doc.count(tag) == 1}")
    sized: InjectResponse = srv.inject("GET", "/sized")
    print(f"content-length follows: {sized.header('Content-Length') == str(len(bytes(sized.body))) and len(sized.body) > len(Document)}")
    wide: InjectResponse = srv.inject("GET", "/unicode")
    wideTag: bool = wide.body.index(tag) > 0 and wide.body.index(tag) < wide.body.index("</body>")
    wideText: bool = "<main>caffè ☕ 日本語 — ünïcödé</main>" in wide.body
    wideLength: str = "bytes" if wide.header("Content-Length") == str(len(bytes(wide.body))) else f"{wide.header('Content-Length')} for {len(bytes(wide.body))} bytes"
    print(f"non-ASCII document: injected={wideTag} text={wideText} content-length={wideLength}")
    print(f"fragment untouched: {srv.inject('GET', '/fragment').body == '<li>partial</li>'}")
    print(f"json untouched: {'script' not in srv.inject('GET', '/data').body}")

    custom: LiveReload = LiveReload([], "/dev/reload", 100)
    other: Server = Server()
    other.get("/", Pages.document)
    custom.register(other)
    print(f"custom path: {'/dev/reload.js' if other.inject('GET', '/dev/reload.js').status == 200 else 'missing'} tag={custom.tag() in other.inject('GET', '/').body}")

    before: dict[str, str] = {"a.css": "1", "b.js": "1", "same": "x"}
    after: dict[str, str] = {"b.js": "2", "c.css": "1", "same": "x"}
    print(f"changes: [{' '.join(LiveReload.changes(before, after))}]")
    checkSnapshots()
    print("ok")
}
