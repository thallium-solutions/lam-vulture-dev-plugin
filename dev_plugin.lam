# @lam/vulture/dev-plugin: development helpers for @lam/vulture servers.
#
# Browser live reload for `lamc dev`: when lamc rebuilds and restarts the
# server, open pages reload; when a watched stylesheet changes, pages swap
# it in place. The plugin is inert unless the process runs under `lamc dev`
# (`LAMC_DEV=1`) or it is forced, so production servers can register it
# unconditionally.

from @lam/vulture import Server, Request, Response, SseEmitter
from lamconcurrency import Mutex
from lamenv import Env
from lamhash import Hash
from lamos import Os
from lampath import Path
from lamtime import Time

const LiveReloadPath: str = "/__lam/live-reload"
const HeartbeatMs: int = 15000
const RecentNs: int = 2000000000

#- What ``LiveReload.snapshot`` knows of a watched file. -#
class AssetStamp {
    func init(self, size: int, modTime: int, hash: str) {
        self.size: int = size
        self.modTime: int = modTime
        self.hash: str = hash
    }

    func matches(self, size: int, modTime: int) -> bool {
        return self.size == size and self.modTime == modTime
    }
}

const LiveReloadScript: str = """(() => {
  const script = document.currentScript;
  const endpoint = script.dataset.endpoint;
  const boot = script.dataset.boot;
  const key = "lam-live-reload:" + location.pathname + location.search;
  const saved = sessionStorage.getItem(key);
  if (saved !== null) {
    sessionStorage.removeItem(key);
    const restore = () => window.scrollTo(0, Number(saved));
    if (document.readyState === "complete") restore();
    else window.addEventListener("load", restore, { once: true });
  }
  let reloading = false;
  const reload = (reason) => {
    if (reloading) return;
    const event = new CustomEvent("lam:live-reload", { cancelable: true, detail: { reason } });
    if (!window.dispatchEvent(event)) return;
    reloading = true;
    sessionStorage.setItem(key, String(window.scrollY));
    location.reload();
  };
  const swapStyles = (names) => {
    const wanted = names.split(",").filter(Boolean);
    const links = [...document.querySelectorAll('link[rel="stylesheet"]')].filter((link) => {
      const path = new URL(link.href, location.href).pathname;
      return wanted.some((name) => path === name || path.endsWith("/" + name));
    });
    if (links.length === 0) return reload("styles");
    const stamp = Date.now().toString(36);
    for (const link of links) {
      const next = link.cloneNode();
      const url = new URL(link.href, location.href);
      url.searchParams.set("lam-live-reload", stamp);
      next.href = url.toString();
      next.addEventListener("load", () => link.remove(), { once: true });
      next.addEventListener("error", () => next.remove(), { once: true });
      link.after(next);
    }
    window.dispatchEvent(new CustomEvent("lam:live-styles", { detail: { names: wanted } }));
  };
  const handle = (type, data) => {
    if (type === "boot") { if (data !== boot) reload("server"); }
    else if (type === "reload") reload("assets");
    else if (type === "styles") swapStyles(data);
  };
  // Browsers open at most 6 HTTP/1.1 connections per host and an open
  // stream holds one, so tabs share a single stream: the tab holding the
  // Web Lock reads it and relays its events over a BroadcastChannel.
  // Without either API (Web Locks need a secure context) every tab keeps
  // its own stream.
  const name = "lam-live-reload " + endpoint;
  const shared = !!(navigator.locks && window.BroadcastChannel);
  const id = Math.random().toString(36).slice(2);
  let source = null;
  let retry = 0;
  let current = null;
  const stream = (relay) => {
    const open = () => {
      source = new EventSource(endpoint);
      for (const type of ["boot", "reload", "styles"]) {
        source.addEventListener(type, (event) => {
          if (type === "boot") current = event.data;
          if (relay) relay.postMessage({ type, data: event.data });
          handle(type, event.data);
        });
      }
      source.onerror = () => { stop(); retry = setTimeout(open, 300); };
    };
    const stop = () => {
      clearTimeout(retry);
      if (source) source.close();
      source = null;
      current = null;
    };
    open();
    return stop;
  };
  let leave = null;
  const join = () => {
    if (!shared) {
      leave = stream(null);
      return;
    }
    const channel = new BroadcastChannel(name);
    const pending = new AbortController();
    let stop = null;
    let release = null;
    channel.onmessage = ({ data }) => {
      // A tab that joins asks the leader for the boot id of the server it
      // streams from; it reloads if its page came from an older server.
      if (data.type === "hello") {
        if (current !== null) channel.postMessage({ type: "boot", data: current, to: data.from });
      } else if (!data.to || data.to === id) handle(data.type, data.data);
    };
    navigator.locks.request(name, { signal: pending.signal }, () => {
      if (pending.signal.aborted) return;
      stop = stream(channel);
      return new Promise((resolve) => { release = resolve; });
    }).catch(() => {});
    channel.postMessage({ type: "hello", from: id });
    leave = () => {
      pending.abort();
      if (stop) stop();
      if (release) release();
      channel.close();
    };
  };
  // Leaving the page (navigation, reload, close, back/forward cache) frees
  // the connection and the lock at once, so a waiting tab or the next page
  // takes over; a page restored from the back/forward cache joins again.
  window.addEventListener("pagehide", () => {
    if (leave) leave();
    leave = null;
  });
  // Chrome does not deliver a close made in pagehide when a history
  // traversal puts the page into the back/forward cache (the connection
  // stays open until the page is restored), so let go before navigating
  // too; if no navigation follows (cancelled, a download), join again.
  window.addEventListener("beforeunload", () => {
    if (leave) leave();
    leave = null;
    setTimeout(() => { if (!leave) join(); }, 1000);
  });
  window.addEventListener("pageshow", (event) => {
    if (event.persisted && !leave) join();
  });
  join();
})();
"""

class LiveReload {
    #- Browser live reload for development servers. ``register`` adds the
    event stream (``path``), its script (``path + ".js"``) and an ``onSend``
    hook placing the script tag before ``</body>`` of every HTML document
    (fragments without ``</body>``, such as htmx partials, are untouched).

    A page reloads when the server it was rendered by has been replaced
    (``lamc dev`` restarted it) or when a watched asset changes; a changed
    stylesheet (``.css``) is swapped in place instead. ``assets`` are
    files or directories watched every ``intervalMs``. Before reloading,
    the page dispatches a cancelable ``lam:live-reload`` window event
    (``detail.reason``: ``server``, ``assets`` or ``styles``); the window
    scroll position is restored after the reload.

    The pages of one browser share a single stream (browsers open at most
    6 HTTP/1.1 connections per host): the tab holding a Web Lock reads it
    and relays its events to the others over a ``BroadcastChannel``;
    without either API each page opens its own. Pages let go of the stream
    when they are left and join again when restored from the back/forward
    cache. -#

    static func enabled() -> bool {
        #- True when the process runs under ``lamc dev`` (``LAMC_DEV=1``). -#
        return Env.getOr("LAMC_DEV", "") == "1"
    }

    func init(self, assets: list[str] = [], path: str = LiveReloadPath, intervalMs: int = 500) {
        self.assets: list[str] = assets
        self.path: str = path
        self.intervalMs: int = max(intervalMs, 50)
        self.boot: str = str(Time.nowUnixNano())
        self.known: dict[str, AssetStamp] = {}
        self.lock: Mutex = Mutex()
        #- Files read and hashed by ``snapshot`` so far. -#
        self.reads: int = 0
    }

    func register(self, srv: Server) {
        srv.get(self.path, self.events)
        srv.get(self.path + ".js", self.script)
        srv.onSend(self.inject)
    }

    func tag(self) -> str {
        #- The script element the ``onSend`` hook inserts. -#
        return f"<script src=\"{self.path}.js\" data-endpoint=\"{self.path}\" data-boot=\"{self.boot}\" defer></script>"
    }

    func script(self, _req: Request, res: Response) {
        res.headers["Cache-Control"] = "no-store"
        res.type_("application/javascript; charset=utf-8").send(LiveReloadScript)
    }

    func events(self, _req: Request, res: Response) {
        res.headers["X-Accel-Buffering"] = "no"
        res.sse(self.stream)
    }

    func stream(self, emitter: SseEmitter) {
        emitter.sendEvent("boot", self.boot)
        reported: dict[str, str] = self.snapshot()
        previous: dict[str, str] = reported
        quietMs: int = 0
        while not emitter.wait(self.intervalMs) {
            current: dict[str, str] = self.snapshot()
            changed: list[str] = LiveReload.changes(reported, current)
            if len(changed) > 0 and len(LiveReload.changes(previous, current)) == 0 {
                if changed.all(lambda name: name.endsWith(".css")) {
                    emitter.sendEvent("styles", ",".join([Path.base(name) for name in changed]))
                } else {
                    emitter.sendEvent("reload", str(len(changed)))
                }
                reported = current
                quietMs = 0
            }
            previous = current
            quietMs += self.intervalMs
            if quietMs >= HeartbeatMs {
                emitter.comment("ping")
                quietMs = 0
            }
        }
    }

    func snapshot(self) -> dict[str, str] {
        #- Content hash of every watched file. Hashes, not modification
        times: they are stable across editors that rewrite files in place.
        A file is read again only when its size or modification time
        changed, or when it was modified in the last ``RecentNs`` (a
        rewrite within one tick of the file system's clock keeps its time);
        the other hashes come from the previous snapshots, shared by every
        stream. -#
        self.lock.lock()
        defer self.lock.unlock()
        recent: int = Time.nowUnixNano() - RecentNs
        known: dict[str, AssetStamp] = {}
        stamps: dict[str, str] = {}
        for root in self.assets {
            for file in Os.walk(root).unwrapOr([]) {
                size: int = Os.fileSize(file).unwrapOr(-1)
                modTime: int = Os.modTime(file).unwrapOr(0)
                if file in self.known and self.known[file].matches(size, modTime) and modTime <= recent {
                    known[file] = self.known[file]
                } else {
                    known[file] = AssetStamp(size, modTime, Hash.sha256(Os.readFile(file).unwrapOr("")))
                    self.reads += 1
                }
                stamps[file] = known[file].hash
            }
        }
        self.known = known
        return stamps
    }

    static func changes(before: dict[str, str], after: dict[str, str]) -> list[str] {
        changed: list[str] = [name for name, stamp in after if name not in before or before[name] != stamp]
        return sorted(changed + [name for name, _ in before if name not in after])
    }

    func inject(self, _req: Request, res: Response) {
        if "Content-Type" not in res.headers or "text/html" not in res.headers["Content-Type"].toLower() {
            return
        }
        at: int = res.body.lastIndex("</body>")
        if at < 0 or self.path + ".js" in res.body {
            return
        }
        res.body = res.body[:at] + self.tag() + res.body[at:]
        if "Content-Length" in res.headers {
            res.headers["Content-Length"] = str(len(res.body))
        }
    }
}

func liveReload(srv: Server, assets: list[str] = [], path: str = LiveReloadPath,
    intervalMs: int = 500, force: bool = false) {
    #- Register browser live reload when the server runs under ``lamc dev``
    (or ``force`` is true); otherwise do nothing. -#
    if force or LiveReload.enabled() {
        LiveReload(assets, path, intervalMs).register(srv)
    }
}

func liveReloadPlugin(assets: list[str] = [], path: str = LiveReloadPath,
    intervalMs: int = 500, force: bool = false) -> func(Server) {
    return lambda (srv: Server) -> None {
        liveReload(srv, assets, path, intervalMs, force)
    }
}
